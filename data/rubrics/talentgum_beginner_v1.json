{
  "rubric_id": "talentgum-beginner",
  "version": 1,
  "description": "TalentGum beginner level (client rules, Nov 2026): right hand only; a right note in another octave counts as correct. Tempo is judged against the teachers' recordings when the song has a benchmark, otherwise against 120 bpm or the score's own tempo, whichever is closer, and never scores below 40. Weights are first guesses: refit with `ras calibrate` on teacher marks.",
  "criteria": [
    {"id": "correct_notes", "label": "Correct notes", "weight": 0.13, "metric": "note_accuracy_pct", "map": {"type": "linear", "from": [40, 98], "to": [0, 100]}},
    {"id": "incorrect_notes", "label": "Incorrect notes", "weight": 0.06, "metric": "wrong_note_rate_pct", "map": {"type": "linear", "from": [25, 0], "to": [0, 100]}},
    {"id": "missed_notes", "label": "Missed notes", "weight": 0.06, "metric": "missing_note_rate_pct", "map": {"type": "linear", "from": [30, 0], "to": [0, 100]}},
    {"id": "extra_notes", "label": "Extra notes", "weight": 0.05, "metric": "extra_note_rate_pct", "map": {"type": "linear", "from": [30, 0], "to": [0, 100]}},
    {"id": "note_order", "label": "Note order", "weight": 0.05, "metric": "note_order_pct", "map": {"type": "linear", "from": [80, 100], "to": [0, 100]}},
    {"id": "chord_correctness", "label": "Chord correctness", "weight": 0.04, "metric": "chord_accuracy_pct", "map": {"type": "linear", "from": [30, 100], "to": [0, 100]}},
    {"id": "missing_chord_notes", "label": "Missing chord notes", "weight": 0.02, "metric": "chord_missing_tone_pct", "map": {"type": "linear", "from": [40, 0], "to": [0, 100]}},
    {"id": "extra_chord_notes", "label": "Extra chord notes", "weight": 0.02, "metric": "chord_extra_tone_rate_pct", "map": {"type": "linear", "from": [50, 0], "to": [0, 100]}},
    {"id": "chord_voicing", "label": "Wrong chord / voicing", "weight": 0.02, "metric": "chord_voicing_ok_pct", "map": {"type": "linear", "from": [50, 100], "to": [0, 100]}},
    {"id": "onset_timing", "label": "Note onset timing", "weight": 0.06, "metric": "onset_within_ms_pct", "params": {"ms": 120}, "map": {"type": "linear", "from": [30, 95], "to": [0, 100]}},
    {"id": "note_duration", "label": "Note duration", "weight": 0.03, "metric": "duration_vs_teacher_pct", "map": {"type": "linear", "from": [40, 95], "to": [0, 100]}, "fallbacks": [{"metric": "duration_within_pct", "params": {"tolerance": 0.5}, "map": {"type": "linear", "from": [30, 90], "to": [0, 100]}}]},
    {"id": "rhythm_accuracy", "label": "Rhythm accuracy", "weight": 0.06, "metric": "rhythm_ioi_within_pct", "map": {"type": "linear", "from": [40, 95], "to": [0, 100]}},
    {"id": "tempo", "label": "Tempo", "weight": 0.04, "metric": "tempo_vs_teacher_pct", "map": {"type": "piecewise", "points": [[0, 100], [10, 100], [30, 70], [60, 40]]}, "fallbacks": [{"metric": "tempo_deviation_pct", "params": {"target_bpm": 120, "or_score_tempo": true}, "map": {"type": "piecewise", "points": [[0, 100], [10, 100], [30, 70], [60, 40]]}}]},
    {"id": "tempo_consistency", "label": "Tempo consistency", "weight": 0.04, "metric": "tempo_consistency_cv_pct", "map": {"type": "linear", "from": [25, 3], "to": [0, 100]}},
    {"id": "timing_deviation", "label": "Timing deviation", "weight": 0.03, "metric": "median_abs_onset_dev_ms", "map": {"type": "linear", "from": [200, 30], "to": [0, 100]}},
    {"id": "unintended_pauses", "label": "Unintended pauses", "weight": 0.04, "metric": "pause_count", "map": {"type": "step", "points": [[0, 100], [1, 70], [2, 40], [4, 0]]}},
    {"id": "dynamics", "label": "Dynamics", "weight": 0.05, "metric": "dynamics_match_pct", "params": {"source": "auto"}, "map": {"type": "linear", "from": [0, 100], "to": [0, 100]}, "fallbacks": [{"metric": "dynamics_vs_teacher_corr", "map": {"type": "linear", "from": [0, 0.8], "to": [0, 100]}}]},
    {"id": "dynamic_consistency", "label": "Dynamic consistency", "weight": 0.04, "metric": "dynamic_consistency_std", "params": {"source": "velocity"}, "map": {"type": "linear", "from": [25, 6], "to": [0, 100]}, "fallbacks": [{"metric": "dynamic_consistency_std", "params": {"source": "model"}, "map": {"type": "linear", "from": [0.8, 0.15], "to": [0, 100]}}]},
    {"id": "articulation", "label": "Articulation", "weight": 0.05, "metric": "articulation_match_pct", "params": {"source": "auto"}, "map": {"type": "linear", "from": [30, 95], "to": [0, 100]}, "fallbacks": [{"metric": "articulation_vs_teacher_pct", "map": {"type": "linear", "from": [40, 95], "to": [0, 100]}}]},
    {"id": "sustain_pedal", "label": "Sustain / pedal", "weight": 0.04, "metric": "pedal_match_pct", "map": {"type": "linear", "from": [50, 95], "to": [0, 100]}},
    {"id": "fluency", "label": "Fluency", "weight": 0.07, "metric": "fluency_index", "params": {"pause": 15, "restart": 20, "hesitation": 5}, "map": {"type": "linear", "from": [0, 100], "to": [0, 100]}}
  ],
  "score_bands": {
    "keep_practising": [
      0,
      55
    ],
    "good": [
      55,
      80
    ],
    "excellent": [
      80,
      100
    ]
  },
  "options": {
    "allow_transposition": true,
    "review_confidence_threshold": 0.6,
    "pause_threshold_s": 1.5,
    "timing_tolerance_ms": 120,
    "second_opinion": [
      "hft"
    ],
    "second_opinion_policy": "uncertain",
    "pedal_source": "primary",
    "verify_missing_audio": false,
    "isolate_melody": true,
    "min_reference_fit": 0.7,
    "hands": "right",
    "octave_errors": "ignore"
  }
}
